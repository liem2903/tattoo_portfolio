# Copy to .env for local development. On Railway, add these as service variables.
# Both values are in Supabase: Project Settings -> API.
# The anon key is meant to be public; the security rules in supabase/setup.sql protect the data.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
